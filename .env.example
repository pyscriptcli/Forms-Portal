# ==========================================
# PRIME Philippines Forms Portal - Vercel Environment Variables
# Add these in Vercel Project Settings -> Environment Variables
# ==========================================

# 1. ClickUp Integration (Required)
# Generate from ClickUp -> Settings -> Apps -> API Token (Personal Token)
CLICKUP_API_TOKEN=pk_your_clickup_personal_api_token
# Target ClickUp List IDs per form (fallback to CLICKUP_LIST_ID if not specified)
RFP_LIST_ID=901420772915
PO_LIST_ID=
PCV_LIST_ID=
CLICKUP_LIST_ID=901420772915

# 2. Public Application URL (Required in Production)
# Set to your Vercel deployment domain (e.g. https://forms.primephilippines.com or https://your-project.vercel.app)
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# 3. AI Document Extraction (RFP Auto-Fill)
# DeepSeek API Key (configured in Vercel as DEEPSEEK_API or DEEPSEEK_API_KEY)
DEEPSEEK_API=your_deepseek_api_key_here
# Google Gemini Vision API Key (Tier 3 fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Microsoft 365 / Outlook Notification Service (Optional)
# If provided, sends real email alerts for Approver reviews and Requestor revision notes.
# Leave blank to run in simulated/logged mode.
OUTLOOK_EMAIL_USER=notifications@primephilippines.com
OUTLOOK_EMAIL_PASS=your_outlook_app_password
OUTLOOK_SMTP_HOST=smtp.office365.com
OUTLOOK_SMTP_PORT=587
EMAIL_FROM_NAME=PRIME Philippines Forms Portal
